<style>

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        font-family:
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            "Noto Sans TC",
            Arial,
            sans-serif;

        background:
            radial-gradient(
                circle at top,
                #202735 0%,
                #11151c 45%,
                #0b0e13 100%
            );

        color: #e6eaf0;

        min-height: 100vh;

        display: flex;
        justify-content: center;
        align-items: center;

        padding: 24px;
    }


    .container {
        width: 100%;
        max-width: 680px;

        background: rgba(23, 28, 37, 0.94);

        border: 1px solid #303846;

        border-radius: 18px;

        padding: 32px;

        box-shadow:
            0 20px 60px rgba(0, 0, 0, 0.45),
            0 0 0 1px rgba(255, 255, 255, 0.02);

        backdrop-filter: blur(12px);
    }


    h1 {
        margin: 0 0 8px;

        font-size: 30px;
        font-weight: 700;

        letter-spacing: -0.5px;

        color: #f4f7fb;
    }


    .subtitle {
        margin: 0 0 28px;

        color: #8f9aaa;

        font-size: 14px;
    }


    .section {
        margin-bottom: 22px;
    }


    .label {
        display: block;

        margin-bottom: 9px;

        font-size: 13px;
        font-weight: 600;

        color: #aeb7c5;
    }


    .file-select {
        width: 100%;

        padding: 13px 15px;

        border-radius: 10px;

        border: 1px solid #3a4352;

        background: #151a22;

        color: #e8ecf2;

        font-size: 15px;

        outline: none;

        cursor: pointer;

        transition:
            border-color 0.2s,
            background 0.2s,
            box-shadow 0.2s;
    }


    .file-select:hover {
        background: #191f29;

        border-color: #4a5668;
    }


    .file-select:focus {
        border-color: #4d8dff;

        box-shadow:
            0 0 0 3px rgba(77, 141, 255, 0.15);
    }


    .file-info {
        display: grid;

        grid-template-columns: 1fr 1fr;

        gap: 12px;

        margin-top: 12px;
    }


    .info-box {
        background: #151a22;

        border: 1px solid #2f3744;

        border-radius: 10px;

        padding: 13px 15px;
    }


    .info-title {
        display: block;

        margin-bottom: 5px;

        color: #7f8a9a;

        font-size: 12px;
    }


    .info-value {
        color: #e8edf5;

        font-size: 14px;

        font-weight: 600;

        word-break: break-word;
    }


    #download {
        width: 100%;

        margin-top: 4px;

        padding: 13px 18px;

        border: none;

        border-radius: 10px;

        background:
            linear-gradient(
                135deg,
                #367ff0,
                #2864d7
            );

        color: white;

        font-size: 15px;

        font-weight: 600;

        cursor: pointer;

        box-shadow:
            0 5px 18px rgba(38, 100, 215, 0.25);

        transition:
            transform 0.15s,
            filter 0.15s,
            box-shadow 0.15s;
    }


    #download:hover:not(:disabled) {
        filter: brightness(1.08);

        transform: translateY(-1px);

        box-shadow:
            0 7px 22px rgba(38, 100, 215, 0.35);
    }


    #download:active:not(:disabled) {
        transform: translateY(0);

        box-shadow:
            0 3px 12px rgba(38, 100, 215, 0.25);
    }


    #download:disabled {
        opacity: 0.45;

        cursor: not-allowed;

        box-shadow: none;
    }


    .status-area {
        margin-top: 28px;
    }


    .status-text {
        margin-bottom: 8px;

        color: #aeb7c5;

        font-size: 14px;

        font-weight: 500;
    }


    .status-text.success {
        color: #61d99b;
    }


    .status-text.error {
        color: #ff7272;
    }


    .percentage {
        margin-bottom: 9px;

        color: #f0f3f8;

        font-size: 25px;

        font-weight: 700;

        letter-spacing: -0.5px;
    }


    .progress-container {
        width: 100%;

        height: 10px;

        overflow: hidden;

        background: #0e1218;

        border: 1px solid #29313d;

        border-radius: 999px;
    }


    #progress {
        width: 0%;

        height: 100%;

        border-radius: inherit;

        background:
            linear-gradient(
                90deg,
                #347cf0,
                #5a9bff
            );

        box-shadow:
            0 0 12px rgba(70, 140, 255, 0.35);

        transition: width 0.15s ease;
    }


    .stats {
        display: flex;

        justify-content: space-between;

        gap: 15px;

        margin-top: 10px;

        color: #818c9c;

        font-size: 12px;
    }


    .stats span {
        white-space: nowrap;
    }


    .message {
        min-height: 20px;

        margin-top: 18px;

        font-size: 13px;

        line-height: 1.5;

        color: #8e99a8;

        word-break: break-word;
    }


    .message.success {
        color: #61d99b;
    }


    .message.error {
        color: #ff7272;
    }


    @media (max-width: 600px) {

        body {
            padding: 14px;
        }


        .container {
            padding: 24px 20px;

            border-radius: 15px;
        }


        h1 {
            font-size: 26px;
        }


        .file-info {
            grid-template-columns: 1fr;
        }


        .stats {
            flex-direction: column;

            gap: 5px;
        }

    }

</style>

