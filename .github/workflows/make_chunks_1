</div>

<script>

const owner = "Stevor0610";
const repo = "chunk-box";
const branch = "main";

const base =
    `https://raw.githubusercontent.com/${owner}/${repo}/${branch}/`;

const fileSelect =
    document.getElementById("fileSelect");

const downloadButton =
    document.getElementById("download");

const statusText =
    document.getElementById("statusText");

const percentage =
    document.getElementById("percentage");

const progress =
    document.getElementById("progress");

const chunkInfo =
    document.getElementById("chunkInfo");

const sizeInfo =
    document.getElementById("sizeInfo");

const fileSize =
    document.getElementById("fileSize");

const fileChunks =
    document.getElementById("fileChunks");

const message =
    document.getElementById("message");

let files = [];


/* ================================
   Settings
================================ */

const MAX_CONNECTIONS = 4;


/* ================================
   Utility
================================ */

function formatSize(bytes) {

    if (bytes < 1024 * 1024) {

        return (
            (bytes / 1024).toFixed(1)
            + " KB"
        );
    }

    if (bytes < 1024 * 1024 * 1024) {

        return (
            (bytes / 1024 / 1024).toFixed(2)
            + " MB"
        );
    }

    return (
        (bytes / 1024 / 1024 / 1024).toFixed(2)
        + " GB"
    );
}


function resetProgress() {

    progress.style.width = "0%";

    percentage.textContent = "0%";

    chunkInfo.textContent = "0 / 0 chunks";

    sizeInfo.textContent = "0 MB";

    statusText.textContent = "Ready";

    statusText.className = "status-text";

    message.textContent = "";

    message.className = "message";
}


function updateProgress(
    downloadedSize,
    totalSize,
    completedChunks,
    totalChunks
) {

    const percent =
        Math.min(
            100,
            Math.round(
                downloadedSize
                / totalSize
                * 100
            )
        );

    progress.style.width =
        `${percent}%`;

    percentage.textContent =
        `${percent}%`;

    chunkInfo.textContent =
        `${completedChunks} / ${totalChunks} chunks`;

    sizeInfo.textContent =
        `${formatSize(downloadedSize)} / ${formatSize(totalSize)}`;
}


function updateFileInfo() {

    const selected =
        files.find(
            file =>
                file.name === fileSelect.value
        );

    if (!selected) {

        fileSize.textContent = "0 MB";

        fileChunks.textContent = "0 chunks";

        return;
    }

    fileSize.textContent =
        formatSize(selected.size);

    fileChunks.textContent =
        `${selected.chunks} chunks`;
}


/* ================================
   Load file list
================================ */

async function loadFiles() {

    try {

        const response =
            await fetch(
                base + "files.json?" + Date.now(),
                {
                    cache: "no-store"
                }
            );

        if (!response.ok) {

            throw new Error(
                "找不到 files.json"
            );
        }

        const data =
            await response.json();

        files =
            data.map(file => {

                if (typeof file === "string") {

                    return {
                        name: file,
                        size: 0,
                        chunks: 0
                    };
                }

                return {
                    name: String(file.name),
                    size: Number(file.size),
                    chunks: Number(file.chunks)
                };
            });

        fileSelect.innerHTML = "";

        if (files.length === 0) {

            const option =
                document.createElement("option");

            option.value = "";

            option.textContent =
                "目前沒有可下載的檔案";

            fileSelect.appendChild(option);

            downloadButton.disabled = true;

            updateFileInfo();

            return;
        }

        for (const file of files) {

            const option =
                document.createElement("option");

            option.value = file.name;

            option.textContent = file.name;

            fileSelect.appendChild(option);
        }

        downloadButton.disabled = false;

        updateFileInfo();

    }
    catch (error) {

        console.error(error);

        fileSelect.innerHTML = "";

        const option =
            document.createElement("option");

        option.textContent =
            "無法載入檔案清單";

        fileSelect.appendChild(option);

        downloadButton.disabled = true;

        message.textContent =
            error.message;

        message.className =
            "message error";
    }
}


/* ================================
   Download one chunk
================================ */

async function downloadChunk(
    fileBase,
    index
) {

    const response =
        await fetch(
            fileBase
            + `chunk_part_${index}`,
            {
                cache: "no-store"
            }
        );

    if (!response.ok) {

        throw new Error(
            `找不到 chunk_part_${index}`
        );
    }

    return await response.arrayBuffer();
}


/* ================================
   Parallel download
================================ */

async function downloadChunks(
    fileBase,
    totalChunks,
    onChunkComplete
) {

    const results =
        new Array(totalChunks + 1);

    let nextChunk = 1;

    async function worker() {

        while (true) {

            const index = nextChunk++;

            if (index > totalChunks) {
                return;
            }

            const data =
                await downloadChunk(
                    fileBase,
                    index
                );

            results[index] = data;

            onChunkComplete(
                index,
                data.byteLength
            );
        }
    }


    const workerCount =
        Math.min(
            MAX_CONNECTIONS,
            totalChunks
        );

    const workers = [];

    for (
        let i = 0;
        i < workerCount;
        i++
    ) {

        workers.push(
            worker()
        );
    }

    await Promise.all(workers);

    return results;
}


/* ================================
   Streaming download
================================ */

async function streamingDownload(
    outputName,
    fileBase,
    totalChunks,
    totalSize
) {

    if (
        typeof window.showSaveFilePicker !==
        "function"
    ) {

        return false;
    }


    statusText.textContent =
        "Choose save location...";


    const handle =
        await window.showSaveFilePicker(
            {
                suggestedName: outputName,

                types: [
                    {
                        description: "File",

                        accept: {
                            "application/octet-stream":
                                [".*"]
                        }
                    }
                ]
            }
        );


    const writable =
        await handle.createWritable();


    const pending =
        new Map();

    let nextToWrite = 1;

    let downloadedSize = 0;

    let completedChunks = 0;


    let nextChunk = 1;


    async function worker() {

        while (true) {

            const index = nextChunk++;

            if (index > totalChunks) {
                return;
            }

            statusText.textContent =
                `Downloading chunk ${index}...`;

            const data =
                await downloadChunk(
                    fileBase,
                    index
                );

            downloadedSize +=
                data.byteLength;

            completedChunks++;


            updateProgress(
                downloadedSize,
                totalSize,
                completedChunks,
                totalChunks
            );


            pending.set(
                index,
                data
            );


            while (
                pending.has(nextToWrite)
            ) {

                const chunk =
                    pending.get(
                        nextToWrite
                    );

                pending.delete(
                    nextToWrite
                );


                statusText.textContent =
                    `Writing chunk ${nextToWrite}...`;


                await writable.write(
                    chunk
                );


                nextToWrite++;
            }
        }
    }


    try {

        const workerCount =
            Math.min(
                MAX_CONNECTIONS,
                totalChunks
            );

        const workers = [];

        for (
            let i = 0;
            i < workerCount;
            i++
        ) {

            workers.push(
                worker()
            );
        }

        await Promise.all(workers);

        await writable.close();

        return true;

    }
    catch (error) {

        try {
            await writable.abort();
        }
        catch (_) {
        }

        throw error;
    }
}


/* ================================
   Blob fallback
================================ */

async function blobDownload(
    outputName,
    fileBase,
    totalChunks,
    totalSize
) {

    const chunks =
        new Array(totalChunks + 1);

    let downloadedSize = 0;

    let completedChunks = 0;


    await downloadChunks(
        fileBase,
        totalChunks,

        (index, byteLength) => {

            downloadedSize +=
                byteLength;

            completedChunks++;

            statusText.textContent =
                `Downloading chunk ${index}...`;

            updateProgress(
                downloadedSize,
                totalSize,
                completedChunks,
                totalChunks
            );
        }
    )
    .then(results => {

        for (
            let i = 1;
            i <= totalChunks;
            i++
        ) {

            chunks[i] =
                results[i];
        }
    });


    statusText.textContent =
        "Reconstructing file...";


    const orderedChunks =
        chunks.slice(1);


    const file =
        new Blob(
            orderedChunks,
            {
                type:
                    "application/octet-stream"
            }
        );


    const url =
        URL.createObjectURL(file);


    const a =
        document.createElement("a");

    a.href = url;

    a.download = outputName;

    document.body.appendChild(a);

    a.click();

    a.remove();


    setTimeout(
        () => {
            URL.revokeObjectURL(url);
        },
        1000
    );
}


/* ================================
   Main download
================================ */

downloadButton.onclick =
    async () => {

        const outputName =
            fileSelect.value;

        if (!outputName) {
            return;
        }


        const selected =
            files.find(
                file =>
                    file.name === outputName
            );

        if (!selected) {
            return;
        }


        downloadButton.disabled = true;

        fileSelect.disabled = true;

        resetProgress();


        try {

            const totalChunks =
                selected.chunks;

            const totalSize =
                selected.size;


            if (
                !totalChunks ||
                !totalSize
            ) {

                throw new Error(
                    "檔案資訊不完整，請重新執行 makechunks workflow。"
                );
            }


            const fileBase =
                base
                + encodeURIComponent(outputName)
                + "/";


            let usedStreaming =
                false;


            /*
             * Modern browsers:
             * parallel download + direct file writing
             */

            if (
                typeof window.showSaveFilePicker ===
                "function"
            ) {

                usedStreaming =
                    await streamingDownload(
                        outputName,
                        fileBase,
                        totalChunks,
                        totalSize
                    );
            }


            /*
             * Fallback:
             * parallel download + Blob
             */

            if (!usedStreaming) {

                await blobDownload(
                    outputName,
                    fileBase,
                    totalChunks,
                    totalSize
                );
            }


            progress.style.width =
                "100%";

            percentage.textContent =
                "100%";

            statusText.textContent =
                "Download completed";

            statusText.className =
                "status-text success";

            chunkInfo.textContent =
                `${totalChunks} / ${totalChunks} chunks`;

            sizeInfo.textContent =
                formatSize(totalSize);

            message.textContent =
                `${outputName} 已準備完成`;

            message.className =
                "message success";

        }
        catch (error) {

            console.error(error);

            statusText.textContent =
                "Download failed";

            statusText.className =
                "status-text error";

            message.textContent =
                error.message;

            message.className =
                "message error";

            progress.style.width =
                "0%";

            percentage.textContent =
                "0%";
        }
        finally {

            downloadButton.disabled =
                false;

            fileSelect.disabled =
                false;
        }
    };


/* ================================
   File selection
================================ */

fileSelect.onchange =
    () => {

        resetProgress();

        updateFileInfo();
    };


loadFiles();

</script>

</body>

